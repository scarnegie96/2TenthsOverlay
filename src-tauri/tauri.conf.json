{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenths",
  "version": "0.4.2",
  "identifier": "dev.tenths.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Tenths overlay",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Tenths",
        "url": "settings.html",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 Scott Carnegie",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OTY4NDQzNUMxQUI2RTcKUldUbnRocGNRNFNXNVNsRkdtaVZTeTNPL09RcjR3UFE3T0RSQlN5SmtmTTM2S1htY3RuWVVKakQK",
      "endpoints": [
        "https://github.com/scarnegie96/Tenths-iRacing-Overlay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
